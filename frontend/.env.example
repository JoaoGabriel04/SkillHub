# Endereço da API usado pelo navegador.
# - docker compose / dev local: http://localhost:7000/api (chama o backend direto)
# - Vercel: /api (passa pelo proxy do próprio site, ver BACKEND_URL)
NEXT_PUBLIC_API_URL=http://localhost:7000/api

# Só na Vercel: origem do backend (sem /api no fim). Ativa o proxy /api/* → BACKEND_URL/api/*
# em next.config.ts. Deixe vazio no desenvolvimento local.
BACKEND_URL=
