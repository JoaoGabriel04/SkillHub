// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String?
  fullName        String
  phone           String?
  cpf             String?   @unique
  cnpj            String?   @unique
  dataNascimento  DateTime?
  genero          String?
  rua             String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  cep             String?
  perfil          String?
  urlPhoto        String?
  competencias    String[]  @default([])
  curriculo       String?
  credits         Int       @default(0)
  googleId        String?   @unique
  discordId       String?   @unique
  profileComplete Boolean   @default(true)
  // refresh tokens emitidos antes disto são recusados (troca de senha encerra as outras sessões)
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())

  passwordResetTokens PasswordResetToken[]
  servicosPublicados  Servico[] @relation("ServicosPublicados")
  servicosExecutados  Servico[] @relation("ServicosExecutados")
  candidaturasEnviadas Candidatura[] @relation("CandidaturasEnviadas")
  transacoes           TransacaoCredito[] @relation("Transacoes")
  avaliacoesFeitas     Avaliacao[] @relation("AvaliacoesFeitas")
  avaliacoesRecebidas  Avaliacao[] @relation("AvaliacoesRecebidas")
}

// Link de "esqueci a senha": guarda só o hash SHA-256 do token enviado por e-mail
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Domínio de Serviços (Fase 17A). Pedido publicado por um usuário; colaboradores se candidatam (17B).
enum CategoriaServico {
  EDUCACAO
  TECNOLOGIA
  DESIGN_ARTE
  REPAROS
}

enum StatusServico {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model Servico {
  id            String           @id @default(uuid())
  titulo        String
  descricao     String
  categoria     CategoriaServico
  remuneracao   Int?             // em créditos; null = "a combinar"
  prazo         DateTime?        // null = sem prazo
  status        StatusServico    @default(ABERTO)
  autorId       String
  autor         User             @relation("ServicosPublicados", fields: [autorId], references: [id], onDelete: Cascade)
  colaboradorId String?          // preenchido na 17B, ao aceitar uma candidatura
  colaborador   User?            @relation("ServicosExecutados", fields: [colaboradorId], references: [id], onDelete: SetNull)
  aceitoEm      DateTime?        // KPI: latência de contratação = aceitoEm - createdAt
  concluidoEm   DateTime?        // KPI: volume de transações concluídas
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  candidaturas  Candidatura[]
  avaliacoes    Avaliacao[]

  @@index([status, categoria, createdAt])
  @@index([autorId])
  @@index([colaboradorId])
}

// Candidaturas a um pedido (Fase 17B): colaboradores se oferecem; o autor aceita uma
enum StatusCandidatura {
  PENDENTE
  ACEITA
  RECUSADA
  RETIRADA
}

model Candidatura {
  id             String            @id @default(uuid())
  servicoId      String
  servico        Servico           @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  colaboradorId  String
  colaborador    User              @relation("CandidaturasEnviadas", fields: [colaboradorId], references: [id], onDelete: Cascade)
  mensagem       String
  valorProposto  Int?              // em créditos; null = aceita a remuneração do pedido
  status         StatusCandidatura @default(PENDENTE)
  createdAt      DateTime          @default(now())

  @@unique([servicoId, colaboradorId])
  @@index([colaboradorId])
}

// Créditos (Fase 17C): toda alteração de User.credits gera uma linha aqui (só pelo credito.service)
enum TipoTransacao {
  BONUS
  RESERVA
  ESTORNO
  RECEBIMENTO
  TAXA
}

model TransacaoCredito {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation("Transacoes", fields: [userId], references: [id], onDelete: Cascade)
  tipo       TipoTransacao
  valor      Int           // positivo entra, negativo sai
  saldoApos  Int
  // só referência, sem relação: o extrato é histórico e não perde o id se o pedido sumir
  servicoId  String?
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
}

// Avaliações entre as partes de um pedido concluído (Fase 17D): o autor avalia o colaborador e vice-versa,
// uma vez cada. A média é calculada na consulta (nada fica guardado no User).
model Avaliacao {
  id           String   @id @default(uuid())
  servicoId    String
  servico      Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  avaliadorId  String
  avaliador    User     @relation("AvaliacoesFeitas", fields: [avaliadorId], references: [id], onDelete: Cascade)
  avaliadoId   String
  avaliado     User     @relation("AvaliacoesRecebidas", fields: [avaliadoId], references: [id], onDelete: Cascade)
  nota         Int      // 1 a 5
  comentario   String?
  createdAt    DateTime @default(now())

  @@unique([servicoId, avaliadorId])
  @@index([avaliadoId])
}
