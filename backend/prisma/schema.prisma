// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String?
  fullName        String
  phone           String?
  cpf             String?   @unique
  cnpj            String?   @unique
  dataNascimento  DateTime?
  genero          String?
  rua             String?
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  estado          String?
  cep             String?
  perfil          String?
  urlPhoto        String?
  competencias    String[]  @default([])
  curriculo       String?
  credits         Int       @default(0)
  googleId        String?   @unique
  discordId       String?   @unique
  profileComplete Boolean   @default(true)
  // refresh tokens emitidos antes disto são recusados (troca de senha encerra as outras sessões)
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())

  passwordResetTokens PasswordResetToken[]
  servicosPublicados  Servico[] @relation("ServicosPublicados")
  servicosExecutados  Servico[] @relation("ServicosExecutados")
  candidaturasEnviadas Candidatura[] @relation("CandidaturasEnviadas")
  transacoes           TransacaoCredito[] @relation("Transacoes")
  avaliacoesFeitas     Avaliacao[] @relation("AvaliacoesFeitas")
  avaliacoesRecebidas  Avaliacao[] @relation("AvaliacoesRecebidas")
  produtosVendidos     Produto[] @relation("ProdutosVendidos")
  compras              PedidoProduto[] @relation("Compras")
  vendas               PedidoProduto[] @relation("Vendas")
}

// Link de "esqueci a senha": guarda só o hash SHA-256 do token enviado por e-mail
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Domínio de Serviços (Fase 17A). Pedido publicado por um usuário; colaboradores se candidatam (17B).
enum CategoriaServico {
  EDUCACAO
  TECNOLOGIA
  DESIGN_ARTE
  REPAROS
}

enum StatusServico {
  ABERTO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

model Servico {
  id            String           @id @default(uuid())
  titulo        String
  descricao     String
  categoria     CategoriaServico
  remuneracao   Int?             // em créditos; null = "a combinar"
  prazo         DateTime?        // null = sem prazo
  status        StatusServico    @default(ABERTO)
  autorId       String
  autor         User             @relation("ServicosPublicados", fields: [autorId], references: [id], onDelete: Cascade)
  colaboradorId String?          // preenchido na 17B, ao aceitar uma candidatura
  colaborador   User?            @relation("ServicosExecutados", fields: [colaboradorId], references: [id], onDelete: SetNull)
  aceitoEm      DateTime?        // KPI: latência de contratação = aceitoEm - createdAt
  concluidoEm   DateTime?        // KPI: volume de transações concluídas
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  candidaturas  Candidatura[]
  avaliacoes    Avaliacao[]

  @@index([status, categoria, createdAt])
  @@index([autorId])
  @@index([colaboradorId])
}

// Candidaturas a um pedido (Fase 17B): colaboradores se oferecem; o autor aceita uma
enum StatusCandidatura {
  PENDENTE
  ACEITA
  RECUSADA
  RETIRADA
}

model Candidatura {
  id             String            @id @default(uuid())
  servicoId      String
  servico        Servico           @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  colaboradorId  String
  colaborador    User              @relation("CandidaturasEnviadas", fields: [colaboradorId], references: [id], onDelete: Cascade)
  mensagem       String
  valorProposto  Int?              // em créditos; null = aceita a remuneração do pedido
  status         StatusCandidatura @default(PENDENTE)
  createdAt      DateTime          @default(now())

  @@unique([servicoId, colaboradorId])
  @@index([colaboradorId])
}

// Créditos (Fase 17C): toda alteração de User.credits gera uma linha aqui (só pelo credito.service)
enum TipoTransacao {
  BONUS
  RESERVA
  ESTORNO
  RECEBIMENTO
  TAXA
  TAXA_RECEBIDA // a taxa entrando na conta da plataforma (contaPlataforma em configs/creditos.ts)
}

model TransacaoCredito {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation("Transacoes", fields: [userId], references: [id], onDelete: Cascade)
  tipo       TipoTransacao
  valor      Int           // positivo entra, negativo sai
  saldoApos  Int
  // só referência, sem relação: o extrato é histórico e não perde o id se o pedido sumir
  servicoId  String?
  pedidoId   String? // Fase 18B: pedido de produtos (também só referência)
  createdAt  DateTime      @default(now())

  @@index([userId, createdAt])
  @@index([pedidoId])
}

// Avaliações entre as partes de um pedido concluído (Fase 17D): o autor avalia o colaborador e vice-versa,
// uma vez cada. A média é calculada na consulta (nada fica guardado no User).
model Avaliacao {
  id           String   @id @default(uuid())
  // Os dois ficam nulos quando o pedido ou a conta de quem avaliou somem: a avaliação continua contando para o avaliado
  servicoId    String?
  servico      Servico? @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  avaliadorId  String?
  avaliador    User?    @relation("AvaliacoesFeitas", fields: [avaliadorId], references: [id], onDelete: SetNull)
  avaliadoId   String
  avaliado     User     @relation("AvaliacoesRecebidas", fields: [avaliadoId], references: [id], onDelete: Cascade)
  nota         Int      // 1 a 5
  comentario   String?
  createdAt    DateTime @default(now())

  @@unique([servicoId, avaliadorId])
  @@index([avaliadoId])
}

// Loja de produtos (Fase 18A). Preço em créditos; o estoque só é escrito pelo produto.repository.
enum CategoriaProduto {
  ARTE_DECORACAO
  ALIMENTOS_BEBIDAS
  MODA_ACESSORIOS
  SERVICOS_DIGITAIS
  EDUCACAO_APOSTILAS
}

enum StatusProduto {
  ATIVO
  PAUSADO
  REMOVIDO // exclusão lógica (o histórico de pedidos da 18B usa snapshots)
}

model Produto {
  id            String           @id @default(uuid())
  nome          String           // 3 a 80
  descricao     String           // 10 a 1000
  categoria     CategoriaProduto
  preco         Int              // em créditos, >= 1
  estoque       Int              // >= 0; 0 = "Esgotado" (continua visível, sem compra)
  digital       Boolean          @default(false) // sem frete: o "envio" é a entrega digital
  whatsappAtivo Boolean          @default(true)
  status        StatusProduto    @default(ATIVO)
  vendedorId    String
  vendedor      User             @relation("ProdutosVendidos", fields: [vendedorId], references: [id], onDelete: Cascade)
  imagens       ProdutoImagem[]
  itensPedido   ItemPedido[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status, categoria, createdAt])
  @@index([vendedorId])
}

model ProdutoImagem {
  id        String  @id @default(uuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  url       String
  publicId  String? // Cloudinary; null nas fotos do seed
  ordem     Int     // 0 = capa

  @@index([produtoId])
}

// Pedidos de produtos (Fase 18B): um por vendedor em cada checkout. O total é reservado do comprador até a confirmação
// do recebimento (paga o vendedor) ou o cancelamento (estorna). SetNull nas partes: o pedido continua contando para os
// KPIs de volume e renda (status, total, concluidoEm) mesmo que uma conta seja excluída.
enum StatusPedidoProduto {
  AGUARDANDO_ENVIO
  ENVIADO
  CONCLUIDO
  CANCELADO
}

enum ParteDoPedido {
  COMPRADOR
  VENDEDOR
}

model PedidoProduto {
  id           String              @id @default(uuid())
  compradorId  String?
  comprador    User?               @relation("Compras", fields: [compradorId], references: [id], onDelete: SetNull)
  vendedorId   String?
  vendedor     User?               @relation("Vendas", fields: [vendedorId], references: [id], onDelete: SetNull)
  status       StatusPedidoProduto @default(AGUARDANDO_ENVIO)
  total        Int                 // em créditos, soma dos itens
  observacao   String?             // até 300
  canceladoPor ParteDoPedido?
  itens        ItemPedido[]
  createdAt    DateTime            @default(now())
  enviadoEm    DateTime?
  concluidoEm  DateTime?           // KPI: volume de transações concluídas e renda gerada (total)
  canceladoEm  DateTime?

  @@index([compradorId, createdAt])
  @@index([vendedorId, createdAt])
  @@index([status, enviadoEm])     // npm run pedidos:pendentes
}

model ItemPedido {
  id            String        @id @default(uuid())
  pedidoId      String
  pedido        PedidoProduto @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId     String?       // SetNull: o histórico não depende do produto
  produto       Produto?      @relation(fields: [produtoId], references: [id], onDelete: SetNull)
  nome          String        // snapshot
  precoUnitario Int           // snapshot, em créditos
  quantidade    Int           // 1 a 99
  imagemUrl     String?       // snapshot da capa
  digital       Boolean       @default(false) // snapshot: "entregue" no lugar de "enviado"

  @@index([pedidoId])
  @@index([produtoId])
}
